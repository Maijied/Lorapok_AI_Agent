{
  "version": 1,
  "hooks": [
    {
      "event": "sessionStart",
      "command": "node .agents/hooks/session-start.js",
      "description": "Point agents at BRAIN and Docs/architecture"
    },
    {
      "event": "beforeShellExecution",
      "command": "node .agents/hooks/before-shell.js",
      "description": "Warn on destructive git commands"
    },
    {
      "event": "afterFileEdit",
      "command": "node .agents/hooks/after-file-edit.js",
      "description": "Remind tests/docs after model or server edits",
      "matchers": [
        "services/Model*.js",
        "server.js",
        "commands/settings.js"
      ]
    },
    {
      "event": "beforePrompt",
      "command": "node .agents/hooks/before-prompt-assembler.js",
      "description": "Dynamically scans the workspace and injects available skills, MCP servers, and subagents into context"
    },
    {
      "event": "afterPromptResponse",
      "command": "node .agents/hooks/post-prompt-trigger.js",
      "description": "Enforce documentation and test synchronization after every agent response"
    }
  ]
}
